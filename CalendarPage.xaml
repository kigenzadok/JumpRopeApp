<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JumpRopeApp.CalendarPage"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}"
             Title="Workout Log">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" MaximumWidthRequest="500">

            <!-- Header & Date Picker Card -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}" 
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A3D}"
                    StrokeShape="RoundRectangle 16"
                    Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Activity Log &amp; Calendar" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />

                    <DatePicker x:Name="WorkoutDatePicker" 
                                HorizontalOptions="Center"
                                TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />
                </VerticalStackLayout>
            </Border>

            <!-- Streak & Milestone Badge Card -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}" 
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A3D}"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="CURRENT STREAK" FontSize="11" FontAttributes="Bold" TextColor="#6366F1" />
                        <Label x:Name="StreakLabel" Text="0 Days" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="ACHIEVEMENT BADGE" FontSize="11" FontAttributes="Bold" TextColor="#10B981" />
                        <Label x:Name="BadgeLabel" Text="Beginner" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Selected Date Workout Details -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E2E}" 
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#2A2A3D}"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="SelectedDateLabel" 
                           Text="Select a Date" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Label x:Name="SetsCompletedLabel" Text="Sets: 0" FontSize="14" TextColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0B2}" />
                        <Label Grid.Column="1" x:Name="TotalJumpsLabel" Text="Jumps: 0" FontSize="14" FontAttributes="Bold" TextColor="#6366F1" />
                    </Grid>

                    <CollectionView x:Name="WorkoutsListView" HeightRequest="250" Margin="0,10,0,0">
                        <CollectionView.EmptyView>
                            <Label Text="No workouts logged for this date." 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" 
                                   TextColor="{AppThemeBinding Light=#6C757D, Dark=#A0A0B2}" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=#F0F0F5, Dark=#272A45}" 
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3F436B}"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="12" 
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="{Binding DateFormatted}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#FFFFFF}" />
                                        <Label Grid.Column="1" Text="{Binding TotalJumps, StringFormat='{0} Jumps'}" FontAttributes="Bold" TextColor="#6366F1" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>