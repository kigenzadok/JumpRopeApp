<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JumpRopeApp.AchievementsPage"
             BackgroundColor="{AppThemeBinding Light=#F4F5F9, Dark=#0F172A}"
             Title="Level &amp; Badges">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" MaximumWidthRequest="480">

            <!-- Level & XP Status Card -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="LEVEL" FontSize="11" FontAttributes="Bold" TextColor="#6366F1" />
                            <Label x:Name="LevelNumberLabel" Text="Level 1" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        </VerticalStackLayout>
                        <Label x:Name="XpRatioLabel" Grid.Column="1" Text="0 / 1,000 XP" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" VerticalOptions="Center" />
                    </Grid>

                    <ProgressBar x:Name="XpProgressBar" Progress="0.0" ProgressColor="#6366F1" HeightRequest="10" />
                </VerticalStackLayout>
            </Border>

            <!-- Badges List -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="🏅 Achievements &amp; Badges" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <CollectionView x:Name="BadgesCollectionView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                        StrokeShape="RoundRectangle 14" Padding="14" Margin="0,0,0,10">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="8">

                                        <!-- Badge Icon -->
                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Icon}" FontSize="28" VerticalOptions="Center" />

                                        <!-- Title & Description -->
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                            <Label Text="{Binding Description}" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                        </VerticalStackLayout>

                                        <!-- Dynamic Unlocked / Locked Status Badge -->
                                        <Border Grid.Row="0" Grid.Column="2" 
                                                BackgroundColor="{Binding StatusColor}" 
                                                StrokeShape="RoundRectangle 8" Padding="8,4" VerticalOptions="Center">
                                            <Label Text="{Binding StatusText}" 
                                                   FontSize="10" FontAttributes="Bold" 
                                                   TextColor="White" HorizontalOptions="Center" />
                                        </Border>

                                        <!-- Progress Bar -->
                                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" 
                                                     Progress="{Binding ProgressRatio}" 
                                                     ProgressColor="#6366F1" HeightRequest="6" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>