<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JumpRopeApp.AchievementsPage"
             BackgroundColor="{AppThemeBinding Light=#F4F5F9, Dark=#0F172A}"
             Title="Level &amp; Badges">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" MaximumWidthRequest="480">

            <!-- Level & XP Status Card -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="LEVEL" FontSize="11" FontAttributes="Bold" TextColor="#6366F1" />
                            <Label x:Name="LevelNumberLabel" Text="Level 1" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        </VerticalStackLayout>
                        <Label x:Name="XpRatioLabel" Grid.Column="1" Text="0 / 1000 XP" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" VerticalOptions="Center" />
                    </Grid>

                    <ProgressBar x:Name="XpProgressBar" Progress="0.0" ProgressColor="#6366F1" HeightRequest="10" />
                </VerticalStackLayout>
            </Border>

            <!-- Badges List -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="🏅 Achievements &amp; Badges" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <CollectionView x:Name="BadgesCollectionView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                        StrokeShape="RoundRectangle 14" Padding="14" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding Icon}" FontSize="28" VerticalOptions="Center" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                            <Label Text="{Binding Description}" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" 
                                               Text="{Binding IsUnlocked, Converter={x:Null}, StringFormat='Unlocked'}"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="#10B981" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>