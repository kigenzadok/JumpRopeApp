<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JumpRopeApp.MainPage"
             BackgroundColor="{AppThemeBinding Light=#F4F5F9, Dark=#0F172A}"
             Title="Workout Timer">

    <Grid>
        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="20" MaximumWidthRequest="480">

                <!-- 1. PRESET WORKOUT CHIPS -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                        StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Quick Presets" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Text="Beginner" Clicked="OnPresetBeginnerClicked" HeightRequest="36" FontSize="11" CornerRadius="8" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" TextColor="#6366F1" />
                            <Button Grid.Column="1" Text="HIIT Burn" Clicked="OnPresetHiitClicked" HeightRequest="36" FontSize="11" CornerRadius="8" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" TextColor="#10B981" />
                            <Button Grid.Column="2" Text="Endurance" Clicked="OnPresetEnduranceClicked" HeightRequest="36" FontSize="11" CornerRadius="8" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" TextColor="#F59E0B" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. CIRCULAR TIMER DISPLAY -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                        StrokeShape="RoundRectangle 24" Padding="20">
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">

                        <!-- Status Badge -->
                        <Border x:Name="StatusBadge" BackgroundColor="#6366F1" StrokeShape="RoundRectangle 12" Padding="16,6" HorizontalOptions="Center">
                            <Label x:Name="StatusTextLabel" Text="READY" FontSize="13" FontAttributes="Bold" TextColor="White" />
                        </Border>

                        <!-- Circular Canvas Stack -->
                        <Grid HeightRequest="220" WidthRequest="220">
                            <GraphicsView x:Name="TimerGraphicsView" HeightRequest="220" WidthRequest="220" HorizontalOptions="Center" VerticalOptions="Center" />

                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                <Label x:Name="TimerTextLabel" Text="00:30" FontSize="42" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" HorizontalOptions="Center" />
                                <Label x:Name="CurrentSetTextLabel" Text="Set 1 of 8" FontSize="13" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Live Stats HUD -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" WidthRequest="260">
                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="EST. JUMPS" FontSize="9" FontAttributes="Bold" TextColor="#6366F1" HorizontalOptions="Center" />
                                    <Label x:Name="LiveJumpsLabel" Text="0" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="CALORIES" FontSize="9" FontAttributes="Bold" TextColor="#EF4444" HorizontalOptions="Center" />
                                    <Label x:Name="LiveCaloriesLabel" Text="0 kcal" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. TIMER CONFIGURATION CONTROLS -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                        StrokeShape="RoundRectangle 20" Padding="20">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">

                        <!-- Jump Time Input -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="Jump (sec)" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="12,2">
                                <Entry x:Name="JumpSecsEntry" Text="30" Keyboard="Numeric" FontSize="14" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Rest Time Input -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                            <Label Text="Rest (sec)" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="12,2">
                                <Entry x:Name="RestSecsEntry" Text="15" Keyboard="Numeric" FontSize="14" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Sets Input -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                            <Label Text="Total Sets" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="12,2">
                                <Entry x:Name="TotalSetsEntry" Text="8" Keyboard="Numeric" FontSize="14" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- RPM / Cadence Input -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                            <Label Text="Speed (RPM)" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="12,2">
                                <Entry x:Name="RpmEntry" Text="120" Keyboard="Numeric" FontSize="14" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Start / Reset Action Buttons -->
                        <Button x:Name="StartStopButton" Grid.Row="2" Grid.Column="0" Text="Start Workout" Clicked="OnStartStopClicked" BackgroundColor="#6366F1" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="48" />
                        <Button x:Name="ResetButton" Grid.Row="2" Grid.Column="1" Text="Reset" Clicked="OnResetClicked" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" FontAttributes="Bold" CornerRadius="12" HeightRequest="48" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 4. POST-WORKOUT SUMMARY OVERLAY MODAL -->
        <Border x:Name="SummaryModalOverlay" IsVisible="False" BackgroundColor="#CC0F172A" Padding="20">
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeShape="RoundRectangle 24" Padding="24" MaximumWidthRequest="380" VerticalOptions="Center">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label Text="🎉 Workout Complete!" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" HorizontalOptions="Center" />

                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10" WidthRequest="280">
                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" StrokeShape="RoundRectangle 12" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="TOTAL JUMPS" FontSize="9" FontAttributes="Bold" TextColor="#6366F1" HorizontalOptions="Center" />
                                <Label x:Name="SummaryJumpsLabel" Text="0" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" StrokeShape="RoundRectangle 12" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="SETS" FontSize="9" FontAttributes="Bold" TextColor="#10B981" HorizontalOptions="Center" />
                                <Label x:Name="SummarySetsLabel" Text="0" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" StrokeShape="RoundRectangle 12" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="DURATION" FontSize="9" FontAttributes="Bold" TextColor="#F59E0B" HorizontalOptions="Center" />
                                <Label x:Name="SummaryDurationLabel" Text="0m 0s" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" StrokeShape="RoundRectangle 12" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="CALORIES" FontSize="9" FontAttributes="Bold" TextColor="#EF4444" HorizontalOptions="Center" />
                                <Label x:Name="SummaryCaloriesLabel" Text="0 kcal" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Button Text="Save &amp; Close" Clicked="OnCloseSummaryClicked" BackgroundColor="#6366F1" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="48" HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>
        </Border>

    </Grid>
</ContentPage>