<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="JumpRopeApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:JumpRopeApp"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F172A}"
    Shell.TabBarForegroundColor="#6366F1"
    Shell.TabBarTitleColor="#6366F1"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}">

    <TabBar x:Name="MainTabBar">
        <Tab Title="Timer">
            <Tab.Icon>
                <FontImageSource Glyph="⏱" Size="20" Color="#6366F1" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>

        <Tab Title="History">
            <Tab.Icon>
                <FontImageSource Glyph="📅" Size="20" Color="#6366F1" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate local:CalendarPage}" Route="CalendarPage" />
        </Tab>

        <Tab Title="Stats">
            <Tab.Icon>
                <FontImageSource Glyph="📊" Size="20" Color="#6366F1" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate local:StatsPage}" Route="StatsPage" />
        </Tab>

        <Tab Title="Badges">
            <Tab.Icon>
                <FontImageSource Glyph="🏆" Size="20" Color="#6366F1" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate local:AchievementsPage}" Route="AchievementsPage" />
        </Tab>

        <Tab Title="Routines">
            <Tab.Icon>
                <FontImageSource Glyph="⚡" Size="20" Color="#6366F1" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate local:RoutinesPage}" Route="RoutinesPage" />
        </Tab>
    </TabBar>

</Shell>