<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="JumpRopeApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:JumpRopeApp"
    Title="JumpRopeApp"
    Shell.FlyoutBehavior="Disabled">

    <!-- BOTTOM TAB BAR NAVIGATION -->
    <TabBar>
        <Tab Title="Timer" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Calendar" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate local:CalendarPage}" Route="CalendarPage" />
        </Tab>
        <Tab Title="Stats" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate local:StatsPage}" Route="StatsPage" />
        </Tab>
        <Tab Title="Achievements" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate local:AchievementsPage}" Route="AchievementsPage" />
        </Tab>
        <Tab Title="Routines" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate local:RoutinesPage}" Route="RoutinesPage" />
        </Tab>
    </TabBar>

</Shell>