<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:JumpRopeApp"
             x:Class="JumpRopeApp.StatsPage"
             BackgroundColor="{AppThemeBinding Light=#F4F5F9, Dark=#0F172A}"
             Title="Analytics &amp; Profile">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="Background" Value="{AppThemeBinding Light=#FFFFFF, Dark=#111827}" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light=#E2E8F0, Dark=#1F2937}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="HasShadow" Value="False" />
            </Style>

            <Style x:Key="StatBoxStyle" TargetType="Frame">
                <Setter Property="Background" Value="{AppThemeBinding Light=#F8FAFC, Dark=#1F2937}" />
                <Setter Property="BorderColor" Value="Transparent" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="HasShadow" Value="False" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" MaximumWidthRequest="480">

            <!-- 1. Daily Progress Ring & Goal Card -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Today's Target Goal" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                        <Label x:Name="GoalPercentLabel" Grid.Column="1" Text="0%" FontSize="16" FontAttributes="Bold" TextColor="#6366F1" />
                    </Grid>

                    <ProgressBar x:Name="GoalProgressBar" Progress="0.0" ProgressColor="#6366F1" HeightRequest="10" />

                    <Label x:Name="GoalProgressTextLabel" Text="0 / 1,000 Jumps Completed" FontSize="13" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- 2. Personal Records (PRs) Card -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Personal Bests 🏆" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="JUMPS" FontSize="8" FontAttributes="Bold" TextColor="#F59E0B" />
                                <Label x:Name="PrMostJumpsLabel" Text="0" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="STEPS" FontSize="8" FontAttributes="Bold" TextColor="#10B981" />
                                <Label x:Name="MostStepsLabel" Text="0" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="SETS" FontSize="8" FontAttributes="Bold" TextColor="#3B82F6" />
                                <Label x:Name="PrMostSetsLabel" Text="0" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="3" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="STREAK" FontSize="8" FontAttributes="Bold" TextColor="#6366F1" />
                                <Label x:Name="PrStreakLabel" Text="0 d" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Weekly Jumps Chart Card -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Weekly Jumps Activity" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                    <Grid ColumnDefinitions="40, *" HeightRequest="130">
                        <VerticalStackLayout Grid.Column="0" Spacing="22" VerticalOptions="Center">
                            <Label Text="2k" FontSize="9" TextColor="#94A3B8" HorizontalOptions="End"/>
                            <Label Text="1k" FontSize="9" TextColor="#94A3B8" HorizontalOptions="End"/>
                            <Label Text="0" FontSize="9" TextColor="#94A3B8" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                        <GraphicsView x:Name="JumpsChartGraphicsView" Grid.Column="1" HeightRequest="130" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Weekly Steps Chart Card -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Weekly Steps Activity" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                    <Grid ColumnDefinitions="40, *" HeightRequest="130">
                        <VerticalStackLayout Grid.Column="0" Spacing="22" VerticalOptions="Center">
                            <Label Text="10k" FontSize="9" TextColor="#94A3B8" HorizontalOptions="End"/>
                            <Label Text="5k" FontSize="9" TextColor="#94A3B8" HorizontalOptions="End"/>
                            <Label Text="0" FontSize="9" TextColor="#94A3B8" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                        <GraphicsView x:Name="StepsChartGraphicsView" Grid.Column="1" HeightRequest="130" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- 4. Profile & Goal Settings Section -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Profile &amp; Settings" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" VerticalOptions="Center" />
                        <Button x:Name="EditProfileButton" Text="Edit" Clicked="OnEditProfileClicked" BackgroundColor="Transparent" TextColor="#6366F1" FontAttributes="Bold" FontSize="13" IsVisible="False" />
                    </Grid>

                    <!-- VIEW MODE -->
                    <VerticalStackLayout x:Name="ProfileViewMode" Spacing="12">
                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="14">
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="NAME" FontSize="9" FontAttributes="Bold" TextColor="#6366F1" />
                                    <Label x:Name="DisplayPageNameLabel" Text="Not set" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="WEIGHT" FontSize="9" FontAttributes="Bold" TextColor="#10B981" />
                                    <Label x:Name="DisplayWeightLabel" Text="-- kg" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Text="HEIGHT" FontSize="9" FontAttributes="Bold" TextColor="#3B82F6" />
                                    <Label x:Name="DisplayHeightLabel" Text="-- cm" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3">
                                    <Label Text="GOAL" FontSize="9" FontAttributes="Bold" TextColor="#F59E0B" />
                                    <Label x:Name="DisplayGoalLabel" Text="1,000" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- EDIT MODE -->
                    <VerticalStackLayout x:Name="ProfileEditMode" Spacing="10" IsVisible="False">
                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="12,2">
                            <Entry x:Name="NameEntry" Placeholder="Full Name" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" FontSize="14" />
                        </Border>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="12,2">
                                <Entry x:Name="WeightEntry" Placeholder="Weight (kg)" Keyboard="Numeric" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" FontSize="14" />
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="12,2">
                                <Entry x:Name="HeightEntry" Placeholder="Height (cm)" Keyboard="Numeric" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" FontSize="14" />
                            </Border>

                            <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeShape="RoundRectangle 12" Padding="12,2">
                                <Entry x:Name="GoalEntry" Placeholder="Daily Goal" Keyboard="Numeric" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" FontSize="14" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                            <Button Text="Save Profile" Clicked="OnSaveProfileClicked" BackgroundColor="#6366F1" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="44" />
                            <Button x:Name="CancelOrDeleteButton" Grid.Column="1" Text="Cancel" Clicked="OnCancelOrDeleteClicked" BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#3B1219}" TextColor="#EF4444" FontAttributes="Bold" CornerRadius="12" HeightRequest="44" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Haptic / Audio Switches -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <Label Text="Haptic Feedback (Vibration)" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" FontSize="14" />
                        <Switch x:Name="HapticsSwitch" Grid.Column="1" Toggled="OnSettingsToggled" OnColor="#6366F1" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Lifetime Overview Card -->
            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Lifetime Overview" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <!-- Grid of Lifetime Stats -->
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="10" RowSpacing="10">

                        <!-- Total Jumps -->
                        <Frame Grid.Row="0" Grid.Column="0" Style="{StaticResource StatBoxStyle}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="TOTAL JUMPS" FontSize="10" TextColor="#6366F1" FontAttributes="Bold"/>
                                <Label x:Name="AllTimeJumpsLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Total Steps -->
                        <Frame Grid.Row="0" Grid.Column="1" Style="{StaticResource StatBoxStyle}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="TOTAL STEPS" FontSize="10" TextColor="#10B981" FontAttributes="Bold"/>
                                <Label x:Name="LifetimeStepsLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Est. Calories -->
                        <Frame Grid.Row="1" Grid.Column="0" Style="{StaticResource StatBoxStyle}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="EST. CALORIES" FontSize="10" TextColor="#EF4444" FontAttributes="Bold"/>
                                <Label x:Name="TotalCaloriesLabel" Text="0 kcal" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Workouts -->
                        <Frame Grid.Row="1" Grid.Column="1" Style="{StaticResource StatBoxStyle}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="WORKOUTS" FontSize="10" TextColor="#F59E0B" FontAttributes="Bold"/>
                                <Label x:Name="TotalWorkoutsLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Avg / Session -->
                        <Frame Grid.Row="2" Grid.Column="0" Style="{StaticResource StatBoxStyle}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="AVG / SESSION" FontSize="10" TextColor="#8B5CF6" FontAttributes="Bold"/>
                                <Label x:Name="AvgJumpsLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- Export & Reset Buttons -->
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Button Text="Export CSV" Clicked="OnExportCsvClicked" BackgroundColor="#10B981" TextColor="White" CornerRadius="8" WidthRequest="130" />
                        <Button Text="Reset Stats" Clicked="OnResetStatsClicked" BackgroundColor="#EF4444" TextColor="White" CornerRadius="8" WidthRequest="130" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Button Text="View Logs" Clicked="OnViewLogsClicked" BackgroundColor="#6366F1" TextColor="White" CornerRadius="8" WidthRequest="100" FontSize="11"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>